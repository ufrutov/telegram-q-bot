# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# gotquestions.online account credentials
GOTQUESTIONS_EMAIL=
GOTQUESTIONS_PASSWORD=

# OpenRouter API key for AI hints
OPENROUTER_API_KEY=

# OpenRouter model used for hint generation (default: openrouter/auto)
# Set to a specific model (e.g. anthropic/claude-3.5-sonnet) to pin a route.
OPENROUTER_HINT_MODEL=

# Supabase (tq-bot-* tables)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis (recommended): for answer/hint storage and JWT cache
REDIS_URL=

# Optional: secret to manually trigger /api/cron/ticker
CRON_SECRET=
