# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# gotquestions.online account credentials
GOTQUESTIONS_EMAIL=
GOTQUESTIONS_PASSWORD=

# OpenRouter API key for AI hints
OPENROUTER_API_KEY=

# OpenRouter model used for hint generation (default: openrouter/auto).
# The auto-router picks from OpenRouter's maintained model pool, avoiding
# fragile `:free` variants that may be withdrawn. It requires API credits.
# Set a specific paid model here only when a pinned model is required.
OPENROUTER_HINT_MODEL=

# OpenRouter max_tokens cap for hint generation (default: 300).
# Raise if hints come back truncated.
OPENROUTER_HINT_MAX_TOKENS=

# Supabase (tq-bot-* tables)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis (recommended): for answer/hint storage and JWT cache
REDIS_URL=

# Optional: secret to manually trigger /api/cron/ticker
CRON_SECRET=
