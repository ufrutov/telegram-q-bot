# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# gotquestions.online account credentials
GOTQUESTIONS_EMAIL=
GOTQUESTIONS_PASSWORD=

# OpenRouter API key for AI hints
OPENROUTER_API_KEY=

# OpenRouter model used for hint generation (default: minimax/minimax-m3:free).
# Set to another model (e.g. openrouter/auto, anthropic/claude-3.5-sonnet) to
# switch providers. The default is a free model that returns Russian hints
# without burning budget on internal reasoning.
OPENROUTER_HINT_MODEL=

# OpenRouter max_tokens cap for hint generation (default: 300).
# Raise if hints come back truncated (shouldn't happen with the default model).
OPENROUTER_HINT_MAX_TOKENS=

# Supabase (tq-bot-* tables)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis (recommended): for answer/hint storage and JWT cache
REDIS_URL=

# Optional: secret to manually trigger /api/cron/ticker
CRON_SECRET=
