# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# gotquestions.online account credentials
GOTQUESTIONS_EMAIL=
GOTQUESTIONS_PASSWORD=

# Default hint provider when no dashboard override is saved: gemini or openrouter.
HINT_PROVIDER=gemini

# OpenRouter API key for AI hints
OPENROUTER_API_KEY=

# OpenRouter model used for hint generation (default: openrouter/auto).
# The auto-router picks from OpenRouter's maintained model pool, avoiding
# fragile `:free` variants that may be withdrawn. It requires API credits.
# Set a specific paid model here only when a pinned model is required.
OPENROUTER_HINT_MODEL=

# OpenRouter max_tokens cap for hint generation (default: 20, maximum: 30).
# A lower value is allowed. Keep it small on low credit balances — the request
# only succeeds if prompt + completion fit the provider's remaining credit.
OPENROUTER_HINT_MAX_TOKENS=

# Gemini API key for AI hints. Provider selection is explicit through
# HINT_PROVIDER or dashboard settings; both provider keys can coexist.
GEMINI_API_KEY=

# Gemini model used for hint generation (default: gemini-3.5-flash).
# Override only when a pinned model is required (e.g. to swap to a larger
# or a regional variant without a code change).
GEMINI_MODEL=

# Supabase (tq-bot-* tables)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Redis: session cache, delivery deduplication and global Bot settings.
# Required to save bot-wide hint model settings; per-chat overrides use Supabase.
REDIS_URL=

# Optional: secret to manually trigger /api/cron/ticker
CRON_SECRET=

# node-telegram-bot-api content-type opt-in. The library emits a
# once-per-process DeprecationWarning for every Buffer media send unless
# this flag is set; see src/bot/botClient.ts and
# https://github.com/yagop/node-telegram-bot-api/blob/master/doc/usage.md#sending-files
# for details. Default in botClient.ts is "1" (opt in), so this stays
# empty in most setups. Set to "0" to opt out and restore the warning
# (useful when reproducing upstream issues with the lib).
NTBA_FIX_350=

# Dashboard browser configuration (public values, bundled at build time).
# Use the same Supabase project as SUPABASE_URL. NEVER put a service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
