{
  "name": "telegram-q-bot",
  "version": "1.1.0",
  "description": "Telegram Question Bot - A Telegram bot deployed on Vercel",
  "keywords": [
    "bot",
    "telegram",
    "vercel",
    "webhook"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/api/webhook.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:vercel": "node .github/vercel/build-vercel.mjs",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:interactions": "npm run build && node test/chat-interaction-settings.cjs",
    "test:integration": "npm run build && node test/supabase-question-state.integration.cjs",
    "validate": "oxlint && oxfmt --check && npm run typecheck",
    "dev": "tsx watch scripts/dev.ts",
    "preview:dashboard": "tsx scripts/dev.ts --preview",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "lucide-react": "^1.73.0",
    "node-telegram-bot-api": "^0.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^5.10.0",
    "tailwind-merge": "^3.7.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/nft": "^1.10.0",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.x"
  }
}
